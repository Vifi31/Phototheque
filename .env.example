# Photothèque — variables d'environnement (copiez ce fichier en .env et adaptez)
# Ce fichier est lu par lib/paths.mjs au démarrage. Les valeurs par défaut
# conviennent à une installation standard.

# Dossier qui contiendra la base, les vignettes, les sauvegardes et les versions.
# Laissez vide pour utiliser ./data (recommandé pour le développement).
PHOTOTHEQUE_HOME=

# Port HTTP local de l'application. 3212 par défaut
# (3210 = Comptes, 3211 = Interets sur la même machine).
PHOTOTHEQUE_PORT=3212

# Adresse d'écoute. 127.0.0.1 = local uniquement (recommandé).
PHOTOTHEQUE_HOST=127.0.0.1
